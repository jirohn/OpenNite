# Copia este archivo a .env.local y rellena los valores de tu proyecto Firebase.
# Sin estas variables OpenNite funciona en modo offline y guarda el perfil en este equipo.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=opennite-tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=opennite-tu-proyecto
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_STORAGE_BUCKET=opennite-tu-proyecto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_FUNCTIONS_REGION=us-central1

# Opcional: se muestra en la documentación; Firebase Auth usa el dominio autorizado.
VITE_GOOGLE_CLIENT_ID=
