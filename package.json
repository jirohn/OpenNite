{
  "name": "opennite",
  "version": "0.1.0-alpha.10",
  "description": "OpenNite - battle royale libre y de codigo abierto para PC, sin construccion.",
  "main": "electron/main.js",
  "author": "OpenNite Contributors",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "assets": "node scripts/fetch-character-kit.mjs",
    "prepare:nature": "node scripts/prepare-quaternius.mjs",
    "prepare:props": "node scripts/prepare-quaternius-props.mjs",
    "icons": "node scripts/build-icons.js",
    "electron": "npm run build && electron .",
    "dist:dir": "npm run icons && npm run build && electron-builder --dir",
    "dist": "npm run icons && npm run build && electron-builder",
    "dist:win": "npm run icons && npm run build && electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "firebase": "^11.10.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.170.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "sharp": "^0.33.5",
    "vite": "^6.0.5"
  },
  "build": {
    "appId": "com.opennite.royale",
    "productName": "OpenNite",
    "copyright": "Copyright © OpenNite Contributors",
    "directories": {
      "output": "release",
      "buildResources": "assets/icons"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "config/**/*",
      "tools/**/*",
      "src/**/*",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "jirohn",
      "repo": "OpenNite",
      "releaseType": "prerelease"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OpenNite"
    },
    "portable": {
      "artifactName": "OpenNite-Portable-${version}.exe"
    },
    "artifactName": "OpenNite-Setup-${version}.${ext}",
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "assets/icons/icon.png"
    }
  }
}
